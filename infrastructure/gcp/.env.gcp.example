# =============================================================================
# ViraWorkx GCP Deployment Config
# Copy this file to .env.gcp and fill in your values.
# NEVER commit .env.gcp — it is in .gitignore.
# =============================================================================

# GCP project settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Production URLs (optional if using Cloud Run auto-generated URLs)
# Set these if you have custom domains mapped
API_URL=https://api.viraworkx.ai
WEB_URL=https://www.viraworkx.ai

# Database
DB_PASSWORD=choose-a-strong-password-here

# Authentication
JWT_SECRET=your-256-bit-secret-here

# Anthropic Claude AI
ANTHROPIC_API_KEY=sk-ant-...

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=https://www.viraworkx.ai,https://viraworkx.ai

# Redis (leave empty to use SKIP_REDIS=true — recommended for initial deploy)
# To use Memorystore, set: redis://10.x.x.x:6379
REDIS_URL=

# Stripe (optional — for billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend email (optional)
RESEND_API_KEY=re_...

# iMocha assessments (optional)
IMOCHA_API_KEY=
IMOCHA_TENANT_ID=
IMOCHA_WEBHOOK_SECRET=
